  <semantic:collaboration id="Collaboration_056dkym">
    <semantic:participant id="Participant_1byvam2" name="Clínica Horizonte - Processo de Atender Solicitação" processRef="Process_0t6dajj" />
    <semantic:textAnnotation id="TextAnnotation_0qdf4jh">
      <semantic:text>Receber solicitação e copiar dados manualmente para planilhas e agenda</semantic:text>
    </semantic:textAnnotation>
    <semantic:textAnnotation id="TextAnnotation_1o1exjn">
      <semantic:text>Validar pedido médico e documentos do paciente. Regra: Exige pedido médico e cadastro mínimo completo</semantic:text>
    </semantic:textAnnotation>
    <semantic:textAnnotation id="TextAnnotation_170t5lr">
      <semantic:text>Obter autorização consultando portais de planos de saúde e acompanhando via planilha</semantic:text>
    </semantic:textAnnotation>
    <semantic:textAnnotation id="TextAnnotation_0v05m2r">
      <semantic:text>Procurar manualmente combinação de unidade, equipamento e horário</semantic:text>
    </semantic:textAnnotation>
    <semantic:textAnnotation id="TextAnnotation_1unxxyk">
      <semantic:text>Enviar orientações de preparo manualmente</semantic:text>
    </semantic:textAnnotation>
    <semantic:textAnnotation id="TextAnnotation_1j2wfw0">
      <semantic:text>Recepcionar, conferir preparo e aplicar questionário clínico</semantic:text>
    </semantic:textAnnotation>
    <semantic:textAnnotation id="TextAnnotation_085fmra">
      <semantic:text>Realizar o exame físico e encaminhar imagens</semantic:text>
    </semantic:textAnnotation>
    <semantic:textAnnotation id="TextAnnotation_15ag5d3">
      <semantic:text>Avaliar prioridade ajustada por mensagens/telefonemas, elaborar e liberar laudo no portal. Ponto de verificação da meta: O gestor mede se ocorreu em até 24h.</semantic:text>
    </semantic:textAnnotation>
