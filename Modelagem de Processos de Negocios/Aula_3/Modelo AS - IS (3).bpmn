        <semantic:flowNodeRef>Gateway_Parecer</semantic:flowNodeRef>
        <semantic:flowNodeRef>Gateway_Parcial</semantic:flowNodeRef>
        <semantic:flowNodeRef>Activity_IndicarComp</semantic:flowNodeRef>
        <semantic:childLaneSet id="LaneSet_Coordenacao_Child">
