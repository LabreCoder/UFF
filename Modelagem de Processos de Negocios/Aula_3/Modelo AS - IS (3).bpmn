  </semantic:collaboration>
  <semantic:process id="Process_UVS">
    <semantic:laneSet id="LaneSet_UVS">
      <semantic:lane id="Lane_Atendimento" name="Central de Atendimento">
        <semantic:flowNodeRef>Event_Start</semantic:flowNodeRef>
