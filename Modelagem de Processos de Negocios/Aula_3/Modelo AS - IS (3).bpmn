    <semantic:startEvent id="Event_Start" name="Necessidade Recebida">
      <semantic:outgoing>Flow_1</semantic:outgoing>
    </semantic:startEvent>
    <semantic:task id="Activity_Receber" name="Receber e Orientar / Criar Protocolo">
      <semantic:incoming>Flow_1</semantic:incoming>
      <semantic:outgoing>Flow_2</semantic:outgoing>
    </semantic:task>
    <semantic:task id="Activity_Verificar" name="Verificar Canais / Controlar Pendências">
      <semantic:incoming>Flow_2</semantic:incoming>
      <semantic:outgoing>Flow_3</semantic:outgoing>
    </semantic:task>
    <semantic:task id="Activity_Conferir" name="Conferir Documentação">
      <semantic:incoming>Flow_3</semantic:incoming>
      <semantic:outgoing>Flow_4</semantic:outgoing>
    </semantic:task>
    <semantic:exclusiveGateway id="Gateway_Completa" name="Completa?">
      <semantic:incoming>Flow_4</semantic:incoming>
      <semantic:outgoing>Flow_CompNao</semantic:outgoing>
      <semantic:outgoing>Flow_CompSim</semantic:outgoing>
    </semantic:exclusiveGateway>
    <semantic:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Receber" />
    <semantic:sequenceFlow id="Flow_2" sourceRef="Activity_Receber" targetRef="Activity_Verificar" />
    <semantic:sequenceFlow id="Flow_3" sourceRef="Activity_Verificar" targetRef="Activity_Conferir" />
    <semantic:sequenceFlow id="Flow_4" sourceRef="Activity_Conferir" targetRef="Gateway_Completa" />
    <semantic:sequenceFlow id="Flow_CompNao" name="Não" sourceRef="Gateway_Completa" targetRef="Activity_Devolver" />
    <semantic:sequenceFlow id="Flow_EndDev" sourceRef="Activity_Devolver" targetRef="Event_EndDevolvido" />
    <semantic:sequenceFlow id="Flow_CompSim" name="Sim" sourceRef="Gateway_Completa" targetRef="Activity_Encaminhar" />
    <semantic:sequenceFlow id="Flow_5" sourceRef="Activity_Encaminhar" targetRef="Activity_Comparar" />
    <semantic:sequenceFlow id="Flow_6" sourceRef="Activity_Comparar" targetRef="Gateway_Parecer" />
    <semantic:sequenceFlow id="Flow_ParSim" name="Sim" sourceRef="Gateway_Parecer" targetRef="Activity_Parecer" />
    <semantic:sequenceFlow id="Flow_ParNao" name="Não" sourceRef="Gateway_Parecer" targetRef="Activity_Decisao" />
    <semantic:sequenceFlow id="Flow_8" sourceRef="Activity_Decisao" targetRef="Gateway_Parcial" />
    <semantic:sequenceFlow id="Flow_ParcSim" name="Sim" sourceRef="Gateway_Parcial" targetRef="Activity_IndicarComp" />
    <semantic:sequenceFlow id="Flow_ParcNao" name="Não" sourceRef="Gateway_Parcial" targetRef="Activity_ReceberSec" />
    <semantic:sequenceFlow id="Flow_9" sourceRef="Activity_IndicarComp" targetRef="Activity_ReceberSec" />
    <semantic:sequenceFlow id="Flow_10" sourceRef="Activity_ReceberSec" targetRef="Gateway_DadosCompletos" />
    <semantic:sequenceFlow id="Flow_DadNao" name="Não" sourceRef="Gateway_DadosCompletos" targetRef="Activity_RetornoIncerto" />
    <semantic:sequenceFlow id="Flow_Retorno" sourceRef="Activity_RetornoIncerto" targetRef="Activity_Parecer" />
    <semantic:sequenceFlow id="Flow_DadSim" name="Sim" sourceRef="Gateway_DadosCompletos" targetRef="Activity_Registar" />
    <semantic:sequenceFlow id="Flow_11" sourceRef="Activity_Registar" targetRef="Activity_Comunicar" />
    <semantic:sequenceFlow id="Flow_12" sourceRef="Activity_Comunicar" targetRef="Event_EndSucesso" />
    <semantic:endEvent id="Event_EndDevolvido" name="Devolvido">
      <semantic:incoming>Flow_EndDev</semantic:incoming>
    </semantic:endEvent>
    <semantic:task id="Activity_Devolver" name="Devolver e Tratar Duplicidade">
      <semantic:incoming>Flow_CompNao</semantic:incoming>
      <semantic:outgoing>Flow_EndDev</semantic:outgoing>
    </semantic:task>
    <semantic:task id="Activity_Comparar" name="Comparar Conteúdo e Carga Horária">
      <semantic:incoming>Flow_5</semantic:incoming>
      <semantic:outgoing>Flow_6</semantic:outgoing>
    </semantic:task>
    <semantic:task id="Activity_Encaminhar" name="Encaminhar à Coordenação">
      <semantic:incoming>Flow_CompSim</semantic:incoming>
      <semantic:outgoing>Flow_5</semantic:outgoing>
    </semantic:task>
    <semantic:task id="Activity_Decisao" name="Tomar Decisão Final">
      <semantic:incoming>Flow_ParNao</semantic:incoming>
      <semantic:incoming>Flow_17idbmm</semantic:incoming>
      <semantic:outgoing>Flow_8</semantic:outgoing>
    </semantic:task>
    <semantic:exclusiveGateway id="Gateway_Parecer" name="Necessita Parecer?">
      <semantic:incoming>Flow_6</semantic:incoming>
      <semantic:outgoing>Flow_ParSim</semantic:outgoing>
      <semantic:outgoing>Flow_ParNao</semantic:outgoing>
    </semantic:exclusiveGateway>
    <semantic:sequenceFlow id="Flow_17idbmm" sourceRef="Activity_Parecer" targetRef="Activity_Decisao" />
    <semantic:exclusiveGateway id="Gateway_Parcial" name="Decisão Parcial?">
      <semantic:incoming>Flow_8</semantic:incoming>
      <semantic:outgoing>Flow_ParcSim</semantic:outgoing>
      <semantic:outgoing>Flow_ParcNao</semantic:outgoing>
    </semantic:exclusiveGateway>
    <semantic:task id="Activity_IndicarComp" name="Indicar Conteúdo Complementar">
      <semantic:incoming>Flow_ParcSim</semantic:incoming>
      <semantic:outgoing>Flow_9</semantic:outgoing>
    </semantic:task>
    <semantic:task id="Activity_Parecer" name="Analisar e Devolver Parecer">
      <semantic:incoming>Flow_ParSim</semantic:incoming>
      <semantic:incoming>Flow_Retorno</semantic:incoming>
      <semantic:outgoing>Flow_17idbmm</semantic:outgoing>
    </semantic:task>
    <semantic:task id="Activity_RetornoIncerto" name="Devolver à Coordenação (Lacuna)">
      <semantic:incoming>Flow_DadNao</semantic:incoming>
      <semantic:outgoing>Flow_Retorno</semantic:outgoing>
    </semantic:task>
    <semantic:task id="Activity_Registar" name="Registar no Sistema">
      <semantic:incoming>Flow_DadSim</semantic:incoming>
      <semantic:outgoing>Flow_11</semantic:outgoing>
    </semantic:task>
    <semantic:task id="Activity_Comunicar" name="Comunicar Estudante (Portal)">
      <semantic:incoming>Flow_11</semantic:incoming>
      <semantic:outgoing>Flow_12</semantic:outgoing>
    </semantic:task>
    <semantic:endEvent id="Event_EndSucesso" name="Sucesso">
      <semantic:incoming>Flow_12</semantic:incoming>
    </semantic:endEvent>
    <semantic:task id="Activity_ReceberSec" name="Receber e Avaliar Dados">
      <semantic:incoming>Flow_ParcNao</semantic:incoming>
      <semantic:incoming>Flow_9</semantic:incoming>
      <semantic:outgoing>Flow_10</semantic:outgoing>
    </semantic:task>
    <semantic:exclusiveGateway id="Gateway_DadosCompletos" name="Dados Completos?">
      <semantic:incoming>Flow_10</semantic:incoming>
      <semantic:outgoing>Flow_DadSim</semantic:outgoing>
      <semantic:outgoing>Flow_DadNao</semantic:outgoing>
    </semantic:exclusiveGateway>
  </semantic:process>
