<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_TOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.1">
  <bpmn:collaboration id="Collab_TOBE">
    <bpmn:participant id="P_TI" name="TI" processRef="Proc_TI" />
    <bpmn:participant id="P_RH" name="Recursos Humanos" />
    <bpmn:messageFlow id="M0" sourceRef="P_RH" targetRef="S" />
    <bpmn:messageFlow id="M1" sourceRef="Edev" targetRef="P_RH" />
    <bpmn:messageFlow id="M2" sourceRef="I1" targetRef="P_RH" />
    <bpmn:messageFlow id="M3" sourceRef="I2" targetRef="P_RH" />
    <bpmn:messageFlow id="M4" sourceRef="Eend" targetRef="P_RH" />
    <bpmn:textAnnotation id="A1">
      <bpmn:text>M1 – Chamado completo: dados básicos, perfil de acessos e foto chegam juntos (fim da consulta à Área e da espera pela foto)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2">
      <bpmn:text>M2 – Chamado incompleto volta ao RH já na triagem</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3">
      <bpmn:text>M3 – Máquina começa em paralelo, logo após a triagem</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A4">
      <bpmn:text>M4 – RH avisado assim que usuário, e-mail e assinatura existem</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A5">
      <bpmn:text>M5 – Preparação da máquina segue o POP atualizado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_A2" sourceRef="G1" targetRef="A2" />
    <bpmn:association id="As_A3" sourceRef="G2" targetRef="A3" />
    <bpmn:association id="As_A4" sourceRef="I2" targetRef="A4" />
    <bpmn:association id="As_A5" sourceRef="T9" targetRef="A5" />
    <bpmn:association id="As_A1" sourceRef="S" targetRef="A1" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_TI" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L_as" name="Assistente de TI">
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_an" name="Analista de TI">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Edev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Chamado de admissão recebido (dados, perfil de acessos e foto)">
      <bpmn:outgoing>F0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S" />
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Triar o chamado e conferir as informações">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Chamado completo?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Edev" name="Chamado devolvido ao RH para complementação">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_Edev" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="I1" name="Confirmar o recebimento do chamado ao RH">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_I1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="G2" name="">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T2" name="Criar usuário no AD">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="Os grupos necessários existem?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G3m" name="">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Associar o usuário aos grupos">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Definir o e-mail corporativo">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6" name="Incluir nas listas de distribuição de e-mail da empresa">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T7" name="Gerar a assinatura de e-mail (foto recebida no chamado)">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="I2" name="Informar o RH: usuário, e-mail e assinatura criados">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_I2" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="G5" name="A máquina já está formatada?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T8" name="Formatar a máquina">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G6" name="">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T9" name="Instalar os aplicativos padrão">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Configurar impressoras e demais ajustes">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T11" name="Gerar termo de Responsabilidade da máquina e dos periféricos">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="G4" name="">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T12" name="Entregar ao colaborador a máquina e a assinatura">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T13" name="Coletar a assinatura do termo de Responsabilidade">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T14" name="Registrar o termo no sistema documental">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_T14">
        <bpmn:targetRef>DS</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="Eend" name="Chamado encerrado e entrega informada ao RH">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_Eend" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS" name="Sistema documental" />
    <bpmn:task id="T3" name="Criar grupo com permissões">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F0" name="" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="F1" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F2" name="Não" sourceRef="G1" targetRef="Edev" />
    <bpmn:sequenceFlow id="F3" name="Sim" sourceRef="G1" targetRef="I1" />
    <bpmn:sequenceFlow id="F4" name="" sourceRef="I1" targetRef="G2" />
