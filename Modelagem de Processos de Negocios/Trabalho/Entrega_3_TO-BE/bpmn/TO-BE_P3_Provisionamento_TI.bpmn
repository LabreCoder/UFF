    <bpmn:sequenceFlow id="F15" name="" sourceRef="T7" targetRef="I2" />
    <bpmn:sequenceFlow id="F16" name="" sourceRef="I2" targetRef="G4" />
    <bpmn:sequenceFlow id="F17" name="Não" sourceRef="G5" targetRef="T8" />
    <bpmn:sequenceFlow id="F18" name="Sim" sourceRef="G5" targetRef="G6" />
    <bpmn:sequenceFlow id="F19" name="" sourceRef="T8" targetRef="G6" />
    <bpmn:sequenceFlow id="F20" name="" sourceRef="G6" targetRef="T9" />
    <bpmn:sequenceFlow id="F21" name="" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="F22" name="" sourceRef="T10" targetRef="T11" />
    <bpmn:sequenceFlow id="F23" name="" sourceRef="T11" targetRef="G4" />
    <bpmn:sequenceFlow id="F24" name="" sourceRef="G4" targetRef="T12" />
    <bpmn:sequenceFlow id="F25" name="" sourceRef="T12" targetRef="T13" />
    <bpmn:sequenceFlow id="F26" name="" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="F27" name="" sourceRef="T14" targetRef="Eend" />
  </bpmn:process>
